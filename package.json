{
  "name": "mirsad",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "install:all": "bash scripts/install.sh",
    "install:semantic": ".venv/bin/pip install -e '.[semantic]' && .venv/bin/python scripts/install_semantic_model.py",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": ".venv/bin/python -m uvicorn mirsad_api.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "npm --prefix apps/web run dev",
    "test": "npm run test:api && npm run test:web",
    "test:api": ".venv/bin/python -m pytest",
    "test:web": "npm --prefix apps/web run test",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "install:browsers": "npm --prefix apps/web exec playwright install chromium",
    "lint": ".venv/bin/ruff check apps/api scripts && npm --prefix apps/web run lint",
    "format": ".venv/bin/ruff format apps/api scripts && npm --prefix apps/web run format",
    "typecheck": "npm --prefix apps/web run typecheck",
    "build": "npm --prefix apps/web run build",
    "reset-db": ".venv/bin/python scripts/reset_db.py",
    "doctor": "node scripts/doctor.mjs",
    "evaluate:search": ".venv/bin/python scripts/evaluate_search_quality.py",
    "evaluate:holdout": ".venv/bin/python scripts/evaluate_blinded_holdout.py",
    "analyze:holdout": ".venv/bin/python scripts/analyze_holdout_relevance.py",
    "evaluate:relevance-recovery": ".venv/bin/python scripts/evaluate_relevance_recovery.py",
    "benchmark": ".venv/bin/python scripts/benchmark_search.py",
    "benchmark:relevance": ".venv/bin/python scripts/benchmark_relevance.py",
    "benchmark:evidence": ".venv/bin/python scripts/evidence_gap_benchmark.py",
    "audit:mixed-source-cap": ".venv/bin/python scripts/audit_mixed_source_cap.py",
    "evaluate:mafer": ".venv/bin/python scripts/evaluate_mafer_planning.py",
    "evaluate:mafer-phase3": "PYTHONPATH=apps/api .venv/bin/python scripts/evaluate_mafer_phase3.py --split development",
    "evaluate:mafer-phase3-arabic": "PYTHONPATH=apps/api .venv/bin/python scripts/analyze_mafer_phase3_arabic.py",
    "evaluate:mafer-phase3-confidence": ".venv/bin/python scripts/analyze_mafer_phase3_confidence.py",
    "evaluate:production-evidence": ".venv/bin/python scripts/production_evidence.py",
    "smoke:production-live": ".venv/bin/python scripts/production_live_smoke.py",
    "verify:searxng-once": ".venv/bin/python scripts/searxng_health_campaign.py",
    "verify:live": ".venv/bin/python scripts/verify_connectors.py",
    "verify-sources": ".venv/bin/python scripts/verify_sources.py",
    "start": "./start.sh",
    "stop": "./stop.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
